resource app_signature "application/x-vnd.sikosis-fatcat";

resource app_flags B_SINGLE_LAUNCH | B_BACKGROUND_APP;

resource(101, "BEOS:ICON") #'VICN' import "artwork/fatcat-icon.hvif";

resource app_version {
	major  = 0,
	middle = 0,
	minor  = 7,
	variety = B_APPV_FINAL,
	internal = 0,
	short_info = "Fat Cat Pomodoro",
	long_info = "A cozy Pomodoro timer that fills your breaks with collectible animated cats."
};
